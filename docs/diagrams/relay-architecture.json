    { "id": "mqtt-over-wss", "from": "mqtt", "to": "broker", "label": "MQTT over WSS", "variant": "dashed", "labelDy": 54 }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "隐私边界",
      "items": [
        "密文只在客户端产生与解读，中继不持有密码",
        "中继可见的明文仅三项：消息 id、焚毁策略、房间销毁时间",
        "房间地址不写入日志，需要时只记哈希前缀"
      ]
    },
    {
      "dot": "amber",
      "title": "准入模型",
      "items": [
        "Durable Object 名由密码派生命名空间决定，只有知道密码才能算出地址",
        "服务端无法验证密码派生签名，也刻意不接触密钥材料",
        "因此不引入全局共享准入密钥这类弱化手段"
      ]
    },
    {
      "dot": "violet",
      "title": "成本与清扫",
      "items": [
        "WebSocket Hibernation：空闲房间不驻留内存",
        "定时统一走 Alarm，开销为 O(房间数) 而非 O(连接数)",
        "焚毁标记有界保留，房间到期即整体清除"
      ]
    }
  ]
