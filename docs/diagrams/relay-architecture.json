    { "id": "hook", "type": "frontend", "label": "useMqttChat", "sublabel": "房间与消息逻辑", "row": 1, "col": 0 },
    { "id": "browser", "type": "external", "label": "浏览器客户端", "sublabel": "两个标签页即两个成员", "row": 2, "col": 0 },
    { "id": "transport", "type": "frontend", "label": "ITransport 适配层", "sublabel": "只认频道语义", "row": 1, "col": 1 },
    { "id": "relay", "type": "frontend", "label": "relayTransport", "sublabel": "WebSocket 客户端", "row": 0, "col": 2 },
