{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-chat-relay",
  "main": "relay/index.ts",
  "compatibility_date": "2025-09-01",
  "dev": {
    "port": 8787
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
