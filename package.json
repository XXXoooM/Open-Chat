{
  "name": "open-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --outDir dist/pages --emptyOutDir",
    "build:pages": "npm run build",
    "typecheck": "tsc -p tsconfig.app.json",
    "typecheck:relay": "tsc -p tsconfig.relay.json",
    "lint": "concurrently npm:typecheck npm:lint:eslint",
    "lint:eslint": "eslint src",
    "precommit": "npm run lint",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "relay:dev": "wrangler dev",
    "relay:check": "wrangler deploy --dry-run --outdir .wrangler-dist",
    "relay:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
